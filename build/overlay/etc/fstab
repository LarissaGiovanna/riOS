# /etc/fstab: informações estáticas do sistema de arquivos para riOS
# <file system>                           <mount point>  <type>  <options>                  <dump> <pass>
UUID=PLACEHOLDER-ROOT                     /              ext4    noatime,errors=remount-ro   0      1
UUID=PLACEHOLDER-ESP                      /boot/efi      vfat    umask=0077                 0      2
