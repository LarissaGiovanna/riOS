#!/usr/bin/env bash
set -u

LOG="${MOCK_SYSTEMCTL_LOG:-${TMPDIR:-/tmp}/mock-systemctl.log}"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
printf '%s\n' "$*" >>"$LOG" 2>/dev/null || true

scope="system"
if [[ "${1:-}" == "--user" ]]; then
  scope="user"
  shift
fi

cmd="${1:-}"
shift || true

case "$cmd" in
  cat)
    unidade="${MOCK_SYSTEMCTL_UNIT:-none}"
    [[ "$unidade" == "both" || "$unidade" == "$scope" ]] && exit 0
    exit 1
    ;;
  is-active)
    [[ "${MOCK_SYSTEMCTL_ACTIVE:-0}" == "1" ]] && exit 0
    exit 3
    ;;
  show-environment)
    [[ "${MOCK_SYSTEMCTL_SESSION:-1}" == "1" ]] && exit 0
    exit 1
    ;;
  start|stop|enable|disable|daemon-reload)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
