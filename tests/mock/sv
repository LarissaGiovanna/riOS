#!/usr/bin/env bash
set -u

LOG="${MOCK_SV_LOG:-${TMPDIR:-/tmp}/mock-sv.log}"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
printf '%s\n' "$*" >>"$LOG" 2>/dev/null || true

case "${1:-}" in
  status)
    if [[ "${MOCK_SV_ACTIVE:-0}" == "1" ]]; then
      printf 'run: rios-session: (pid 1234) 1s; run: log: (pid 1235) 1s\n'
      exit 0
    fi
    printf 'down: rios-session: 1s, normally up\n'
    exit 1
    ;;
  start|up|stop|down)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
